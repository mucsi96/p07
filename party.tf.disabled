# Disabled, matching the previous p07 configuration. Rename to party.tf to enable.
# Application-owned infrastructure; reusable modules remain pinned to v-101.

locals {
  party_app_hostname = "party.${data.azurerm_key_vault_secret.dns_zone.value}"
}

module "party_app_base" {
  source = "git::https://github.com/mucsi96/k8s-modules.git//modules/setup_app_base?ref=v-101"

  github_repository      = "speaking-character"
  environment_name       = var.environment_name
  app_name               = "party"
  azure_location         = var.azure_location
  tenant_id              = data.azurerm_client_config.current.tenant_id
  azure_subscription_id  = var.azure_subscription_id
  owner                  = local.owner
  twingate_service_key   = sensitive(module.setup_twingate_access.service_key)
  app_hostname           = local.party_app_hostname
  api_client_id          = module.setup_party_api.client_id
  api_client_secret      = module.setup_party_api.client_secret
  spa_client_id          = module.setup_party_spa.client_id
  api_resource_object_id = module.setup_party_api.resource_object_id
  k8s_oidc_config        = sensitive(module.setup_cluster.k8s_oidc_config)
  client_log_url         = local.client_log_url
}

module "setup_party_api" {
  source = "git::https://github.com/mucsi96/k8s-modules.git//modules/register_api?ref=v-101"
  owner  = local.owner

  display_name = "Party API"
  roles        = ["readParties", "createParty"]

  k8s_oidc_issuer_url           = module.setup_cluster.oidc_issuer_url
  k8s_service_account_namespace = "party"
  k8s_service_account_name      = "party-api-workload-identity"
}

module "setup_party_spa" {
  source = "git::https://github.com/mucsi96/k8s-modules.git//modules/register_spa?ref=v-101"
  owner  = local.owner

  display_name  = "Party SPA"
  redirect_uris = ["https://${local.party_app_hostname}/", "http://localhost:4204/"]

  api_id        = module.setup_party_api.application_id
  api_client_id = module.setup_party_api.client_id
  api_scope_id  = module.setup_party_api.scope_id
}

resource "kubernetes_persistent_volume_v1" "party_app_pv" {
  metadata {
    name = "party-app"
  }

  spec {
    storage_class_name = ""
    access_modes       = ["ReadWriteOnce"]
    capacity = {
      storage = "5Gi"
    }
    persistent_volume_reclaim_policy = "Retain"
    persistent_volume_source {
      host_path {
        path = "/data/party"
      }
    }
  }
}

resource "kubernetes_persistent_volume_v1" "party_backup_pv" {
  metadata {
    name = "party-backup"
  }

  spec {
    storage_class_name = ""
    access_modes       = ["ReadWriteOnce"]
    capacity = {
      storage = "5Gi"
    }
    persistent_volume_reclaim_policy = "Retain"
    persistent_volume_source {
      host_path {
        path = "/data/party"
      }
    }
  }
}
