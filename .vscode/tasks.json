{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  // All tasks run inside the Nix flake dev shell (nix develop --command ...)
  // so the required CLI tools are always on PATH.
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "command": "nix",
      "label": "Create cluster",
      "args": ["develop", "--command", "bash", "scripts/create.sh"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "command": "nix",
      "label": "Init",
      "args": ["develop", "--command", "bash", "scripts/init.sh", "p07"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "command": "nix",
      "label": "Pull kube admin config",
      "args": [
        "develop",
        "--command",
        "bash",
        "scripts/pull_kube_admin_config.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "command": "nix",
      "label": "Install dependencies",
      "args": [
        "develop",
        "--command",
        "bash",
        "scripts/install_dependencies.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "command": "nix",
      "label": "Start DB proxy",
      "args": ["develop", "--command", "bash", "scripts/start_db_proxy.sh"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "type": "shell",
      "command": "nix",
      "label": "Login to Azure",
      "args": ["develop", "--command", "az", "login"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "command": "nix",
      "label": "Monitor server",
      "args": ["develop", "--command", "bash", "scripts/monitor_server.sh"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "type": "shell",
      "command": "nix",
      "label": "List Terraform warnings",
      "args": ["develop", "--command", "bash", "scripts/plan_warnings.sh"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
