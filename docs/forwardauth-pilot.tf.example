# Copy as forwardauth_override.tf ONLY after main.tf pins a published k8s-modules
# release containing setup_app_forwardauth and enable_forward_auth. That module
# pins published ForwardAuth chart 1.0.0. Terraform merges *_override.tf
# blocks with the existing module calls; existing resource addresses are retained.
locals {
  forwardauth_pilot = {
    retain_spa_redirects = true # Preprovision; switch to false after app cutover.
    trusted_proxy_cidrs  = ["10.42.0.0/16"]
    session_redis = {
      connection_url = module.create_redis.connection_url
      password       = module.create_redis.password
    }
    gateway_parent_ref = module.setup_ingress_controller.gateway_parent_ref
  }
}

module "setup_ingress_controller" {
  enable_forward_auth = true
}

module "setup_hello_app" {
  forward_auth = local.forwardauth_pilot
}

module "setup_cooking_app" {
  forward_auth = local.forwardauth_pilot
}
